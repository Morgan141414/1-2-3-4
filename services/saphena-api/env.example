API_DB_URL=jdbc:postgresql://saphena-db-host:5432/db_name
API_DB_USERNAME=postgres
API_DB_PASSWORD=change-me

# This token must be encoded using Base64 and be at least 256 bits long (you can type `openssl rand -base64 64` on your command line, to generate a 512 bits one `openssl rand -base64 128`)
API_JWT_SECRET=

# Notification service configuration
NOTIFICATION_SERVICE_URL=http://localhost:3000
NOTIFICATION_SERVICE_ENABLED=true
NOTIFICATION_SEND_DELAY_MS=1000
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_CHECK_INTERVAL_MS=60000

SAPHENA_NOTIFICATION_API_DOCKER_IMAGE=registry.gitlab.com/saphena/notification-api:main
SAPHENA_API_DOCKER_IMAGE=registry.gitlab.com/saphena/api:main
SAPHENA_WEB_DOCKER_IMAGE=registry.gitlab.com/saphena/web:main
SAPHENA_WHATSAPP_BOT_DOCKER_IMAGE=registry.gitlab.com/saphena/whatsapp-bot:main

MOBIZON_API_KEY=

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me

KEYCLOAK_HOSTNAME=dev.account.mis.qormed.kz
KEYCLOAK_ADMIN_USERNAME=test
KEYCLOAK_ADMIN_PASSWORD=change-me

KC_ADMIN_SERVER_URL=http://saphena-keycloak:8081
KC_ADMIN_CLIENT_SECRET=
OAUTH2_ISSUER_URI:http://saphena-keycloak:8081/realms/qormed

SAPHENA_WEB_PRODUCTION=false
